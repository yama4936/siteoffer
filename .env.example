# ローカル開発用の例。実際の値は .env に書き、Gitに入れない。
# pnpm dev:setup でランダムなパスワードを持つ .env を作成する。
POSTGRES_PASSWORD=
DATABASE_PORT=54329
DATABASE_URL=
# Dockerなしの開発DB（pnpm dev:db）では次の値を .env に設定する。
# DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
WEB_PORT=3100
PREVIEW_PORT=3200
# 国税庁法人番号システムWeb-APIのアプリケーションID（未申請）
NTA_APPLICATION_ID=
# PageSpeed Insights のAPIキー（任意）
PSI_API_KEY=
# 現在のChatGPTログインを使うホスト側ワーカー（pnpm codex:setup が設定）
# Composeの通常ワーカーは引き続きモック。切替は pnpm codex:worker。
SITEOFFER_GENERATOR=mock
SITEOFFER_CODEX_AUTH_FILE=
SITEOFFER_CODEX_IMAGE=siteoffer-codex:local
SITEOFFER_CODEX_NETWORK=bridge
SITEOFFER_CODEX_USER=
# モデルは未決。空欄ならCLIの既定で、アプリ側の選定とは扱わない。
SITEOFFER_CODEX_MODEL=
# デモ（pnpm demo。手順は demo/README.md）。pnpm demo は下の値を自分で設定するので、通常は書かなくてよい。
# 評価設定。デモでは config/site-evaluation.demo.json（閾値はデモ用の仮値。ユーザーが決めた値ではない）
SITEOFFER_EVAL_CONFIG=
# 生成の入力：default（収集した情報）／ fixture（fixtures/codex/input.json。モック生成器のときだけ）
SITEOFFER_GENERATION_INPUT=default
# ワーカーがDBから収集ジョブ・納品を拾う間隔（ミリ秒。0で停止）
SITEOFFER_INTAKE_INTERVAL_MS=5000
SITEOFFER_PROPOSAL_CONCURRENCY=
SITEOFFER_DELIVERY_ARTIFACT_DIR=
# web から見たプレビューのURL・web自身のURL（共有リンク・顧客確認URLの組み立てに使う）
PREVIEW_BASE_URL=http://localhost:3200
WEB_BASE_URL=http://localhost:3100
DEMO_DB_PORT=
DEMO_WEB_PORT=
DEMO_PREVIEW_PORT=
