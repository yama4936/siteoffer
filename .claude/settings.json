{
  "permissions": {
    "allow": [
      "Bash(git push origin main)",
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch origin)",
      "Bash(git pull --rebase origin main)",
      "Bash(git merge-base --is-ancestor origin/main HEAD)",
      "Bash(git ls-remote origin refs/heads/main)",
      "Bash(git rev-parse *)",
      "Bash(scripts/git-check.sh)"
    ],
    "deny": [
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-hooks/track-edit.sh 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-hooks/stop-git.sh",
            "timeout": 20,
            "statusMessage": "未コミットの変更を確認中"
          }
        ]
      }
    ]
  }
}
