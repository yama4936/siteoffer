FROM node:24-bookworm-slim

WORKDIR /app
# This image contains only the isolated runtime, not the web app or database code.
COPY packages/generation/src/sandbox/runtime/package.json packages/generation/src/sandbox/runtime/package-lock.json ./
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm ci --omit=dev --no-audit --no-fund
COPY packages/generation/src/sandbox /app/packages/generation/src/sandbox
RUN mkdir -p /home/codex/.codex /work \
    && chmod 755 /home/codex /home/codex/.codex /work
ENV HOME=/home/codex CODEX_HOME=/home/codex/.codex
WORKDIR /work
USER 1000:1000
CMD ["node", "/app/packages/generation/src/sandbox/container-entry.ts"]
