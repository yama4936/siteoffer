{
  "name": "siteoffer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json && tsc -p demo/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:postgres:audits": "node --import tsx apps/worker/test/postgres-audits.ts",
    "test:postgres:sales": "node --import tsx apps/worker/test/postgres-sales.ts",
    "check": "scripts/check.sh",
    "db:generate": "pnpm --filter @siteoffer/db generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/db/src/migrate.ts",
    "dev:setup": "node scripts/setup-local.mjs",
    "dev:seed": "node --env-file-if-exists=.env --import tsx scripts/seed-local.ts",
    "dev:users": "node --import tsx scripts/seed-local.ts --show",
    "reports:import": "node --env-file-if-exists=.env --import tsx scripts/import-reports.ts",
    "dev:check": "node --env-file-if-exists=.env --import tsx scripts/check-local.ts",
    "codex:setup": "node scripts/setup-codex.mjs && docker build -f Dockerfile.codex -t siteoffer-codex:local .",
    "codex:check": "node --env-file-if-exists=.env --import tsx scripts/check-codex.ts",
    "codex:worker": "docker compose stop worker && pnpm dev:worker",
    "dev:worker": "node --env-file-if-exists=.env --import tsx apps/worker/src/index.ts",
    "dev": "pnpm dev:setup && docker compose up --build --detach --wait",
    "dev:stop": "docker compose down",
    "dev:db": "pnpm --filter @siteoffer/db dev-server",
    "dev:web": "pnpm --filter @siteoffer/web dev --hostname 127.0.0.1",
    "dev:web:exec": "pnpm --filter @siteoffer/web dev --hostname 127.0.0.1",
    "demo": "node --import tsx demo/run.ts",
    "demo:backup": "node --import tsx demo/backup.ts create",
    "demo:restore": "node --import tsx demo/backup.ts restore",
    "demo:restored": "node --import tsx demo/restored.ts",
    "demo:stop": "node --import tsx demo/backup.ts stop",
    "demo:unlock": "node --import tsx demo/backup.ts unlock",
    "demo:reset": "node --import tsx demo/run.ts --reset",
    "demo:users": "node --import tsx demo/seed.ts --show",
    "demo:promote-imported": "node --import tsx apps/web/scripts/demo-promote-imported.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
