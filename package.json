{
  "name": "siteoffer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "scripts/check.sh",
    "db:generate": "pnpm --filter @siteoffer/db generate",
    "dev:db": "pnpm --filter @siteoffer/db dev-server",
    "dev:web": "pnpm --filter @siteoffer/web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
