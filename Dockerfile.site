FROM node:24-bookworm-slim
WORKDIR /app/templates/astro-site
COPY templates/astro-site/runtime/package.json templates/astro-site/runtime/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY templates/astro-site/build ./build
COPY templates/astro-site/check ./check
COPY templates/astro-site/lib ./lib
COPY templates/astro-site/schema ./schema
COPY templates/astro-site/src ./src
COPY templates/astro-site/astro.config.ts ./astro.config.ts
COPY tsconfig.base.json /app/tsconfig.base.json
COPY templates/astro-site/runtime ./runtime
COPY scripts/runtime-fingerprint.ts /app/scripts/runtime-fingerprint.ts
COPY Dockerfile.site /app/Dockerfile.site
ARG SITEOFFER_SOURCE_SHA256
RUN node /app/scripts/runtime-fingerprint.ts site /app "${SITEOFFER_SOURCE_SHA256}" > /app/siteoffer-runtime.json
LABEL org.siteoffer.runtime.kind="site" org.siteoffer.runtime.source-sha256="${SITEOFFER_SOURCE_SHA256}"
ENV ASTRO_TELEMETRY_DISABLED=1 HOME=/tmp SITEOFFER_SITE_SANDBOX=1
USER 1000:1000
WORKDIR /work
CMD ["node", "/app/templates/astro-site/build/container-entry.ts"]
