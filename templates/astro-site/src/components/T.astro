---
/**
 * 文字列を出力する。要確認マーカーは営業用のデモ画面には出さない。
 * マーカー自体はビルド結果の markers に残り、運営レビューで確認する。
 * delivery ではマーカーが残っているとビルド前に失敗する。
 */
import { hasMarker } from "../../lib/markers.ts";

interface Props {
  text: string;
}
const { text } = Astro.props;
// 確認注記だけを削ると、未確認の主張だけが残ることがあるため項目全体を省く。
const visibleText = hasMarker(text) ? "" : text;
---
{visibleText}
