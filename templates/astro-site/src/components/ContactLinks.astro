---
/**
 * 電話・メールのリンク。フォームは作らない（11章）。
 * 値に要確認マーカーがある連絡手段は営業用画面から省く。primary が未確認なら確認済みの手段へフォールバックする。
 */
import { hasMarker } from "../../lib/markers.ts";
import { telHref } from "../../lib/resolve.ts";
import type { SiteInput } from "../../schema/site-input.ts";

interface Props {
  contact: SiteInput["contact"];
  /** primary だけを出す（ファーストビュー用）。 */
  primaryOnly?: boolean;
}
const { contact, primaryOnly = false } = Astro.props;
const validPhone = contact.phone && !hasMarker(contact.phone.display) && !hasMarker(contact.phone.tel);
const validEmail = contact.email && !hasMarker(contact.email);
const preferred =
  contact.primary === "phone" && validPhone
    ? "phone"
    : contact.primary === "email" && validEmail
      ? "email"
      : validPhone
        ? "phone"
        : "email";
const showPhone = validPhone && (!primaryOnly || preferred === "phone");
const showEmail = validEmail && (!primaryOnly || preferred === "email");
const order = preferred === "email" ? ["email", "phone"] : ["phone", "email"];
---
<ul class="contact-links">
  {order.map((kind) => {
    if (kind === "phone" && showPhone && contact.phone) {
      const p = contact.phone;
      return (
        <li>
          <a class:list={["btn", preferred === "phone" ? "btn-primary" : "btn-secondary"]} href={telHref(p)} data-contact="phone">
            電話する：{p.display}
          </a>
        </li>
      );
    }
    if (kind === "email" && showEmail && contact.email) {
      const e = contact.email;
      return (
        <li>
          <a class:list={["btn", preferred === "email" ? "btn-primary" : "btn-secondary"]} href={`mailto:${e}`} data-contact="email">
            メールで問い合わせる：{e}
          </a>
        </li>
      );
    }
    return null;
  })}
</ul>
